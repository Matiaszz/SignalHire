
# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Configuration
POSTGRES_DB=signalhire
POSTGRES_USER=signalhire
POSTGRES_PASSWORD=signalhire_secret
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Spring Datasource (Local dev defaults to localhost:5432)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/signalhire
SPRING_DATASOURCE_USERNAME=signalhire
SPRING_DATASOURCE_PASSWORD=signalhire_secret

# RabbitMQ Configuration
RABBITMQ_DEFAULT_USER=signalhire
RABBITMQ_DEFAULT_PASS=signalhire_secret
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost

# Spring RabbitMQ (Local dev defaults to localhost:5672)
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=signalhire
SPRING_RABBITMQ_PASSWORD=signalhire_secret

# Spring AI (Google GenAI Gemini API)
# Get your key at: https://aistudio.google.com/
SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
SPRING_AI_GOOGLE_GENAI_CHAT_OPTIONS_MODEL=gemini-2.5-flash

# Spring Boot Actuator / Health
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Default Security Credentials (optional dev basic auth)
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin
