
# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# MongoDB Configuration
MONGODB_NAME=signalhire
MONGODB_USER=your_mongo_user
MONGODB_PASSWORD=your_mongo_password
MONGODB_URL=mongodb+srv://your_mongo_user:your_mongo_password@your-cluster.mongodb.net/
SPRING_DATA_MONGODB_URI=mongodb+srv://your_mongo_user:your_mongo_password@your-cluster.mongodb.net/signalhire?retryWrites=true&w=majority
SPRING_DATA_MONGODB_DATABASE=signalhire

# Spring AI (Google GenAI Gemini API)
# Get your key at: https://aistudio.google.com/
SPRING_AI_GOOGLE_GENAI_API_KEY=your_gemini_api_key_here
SPRING_AI_GOOGLE_GENAI_CHAT_OPTIONS_MODEL=gemini-2.5-flash

# Spring Boot Actuator / Health
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# Default Security Credentials (optional dev basic auth)
SECURITY_USER_NAME=admin
SECURITY_USER_PASSWORD=admin

# JWT & CORS Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=c2lnbmFsaGlyZS1zdXBlci1zZWNyZXQta2V5LWZvci1qd3QtaHMAC256LTI1Ni1iaXRzLW1pbmltdW0tMjAyNg==
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000
JWT_COOKIE_NAME=signalhire_refresh_token
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=Lax

# AWS S3 / LocalStack Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_S3_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET=signalhire-avatars
AWS_S3_PATH_STYLE_ACCESS=true

LOCALSTACK_AUTH_TOKEN=ls-teste